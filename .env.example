# Copy this file to .env and replace the values with your own credentials.
# Do not commit .env or share its contents.
DATABASE_URL=postgres://YOUR_DB_USER:YOUR_DB_PASSWORD@localhost:5432/connectai_hub?sslmode=disable
APP_ADDR=:8080
APP_ENV=development
GEMINI_API_KEY=your_actual_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash

# Optional: OpenRouter takes priority when OPENROUTER_API_KEY is set.
# Set OPENROUTER_MODEL to a model slug from the OpenRouter model catalogue.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto
# Optional ordered fallback model. OpenRouter tries the primary model first.
OPENROUTER_FALLBACK_MODEL=
# Optional per-workspace overrides. Leave blank to inherit OPENROUTER_MODEL.
OPENROUTER_MODEL_STUDY=
OPENROUTER_MODEL_CAREER=
OPENROUTER_MODEL_BUSINESS=
OPENROUTER_MODEL_DOCUMENTS=
OPENROUTER_MODEL_WEBSITE=
OPENROUTER_MODEL_SUPPORT=
OPENROUTER_MODEL_DATA=
# Password reset email delivery (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=accounts@example.com
APP_BASE_URL=https://your-deployed-domain.example

# Batch 11 production controls
APP_ENV=development
# Exact email address of an existing account to grant admin access
ADMIN_EMAIL=
# Per-user successful AI requests per database day (default 100)
DAILY_AI_REQUEST_LIMIT=100

PAYSTACK_PLUS_AMOUNT_KOBO=300000
PAYSTACK_SECRET_KEY=